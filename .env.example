# ── Round Table env template. Copy to .env.local and fill in. Never commit real keys. ──
# DeepSeek (OpenAI-compatible). Models: deepseek-v4-flash (thinking on/off), deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Default DeepSeek model ids (user asked for v4-flash across seats)
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-flash

# GLM / Zhipu (OpenAI-compatible at https://open.bigmodel.cn/api/paas/v4)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Default GLM model (flash family; user asked for glm flash — override to glm-5.x-flash when available)
GLM_MODEL=glm-4-flash

# Search (Trend-Watcher). tavily | stub
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily

# GitHub ingestion
GITHUB_TOKEN=
GITHUB_USERNAME=

# App
DATABASE_URL=file:./data/roundtable.db
APP_USER_ID=local-user
RUN_BUDGET_USD=1.00
RUN_MAX_TOKENS=250000
RUN_MAX_CALLS=60
LOG_LEVEL=info
MOCK_LLM=false
