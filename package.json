{
  "name": "roundtable",
  "version": "1.0.0",
  "private": true,
  "description": "Weighted Multi-Agent Idea Generator — eight AI agents around a virtual round table",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server drizzle/migrate.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "ingest-profile": "tsx --conditions=react-server scripts/ingest-profile.ts",
    "smoke": "tsx --conditions=react-server scripts/smoke-run.ts"
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@libsql/client": "^0.15.0",
    "@octokit/graphql": "^8.2.1",
    "@octokit/rest": "^21.1.1",
    "@tanstack/react-query": "^5.62.0",
    "drizzle-orm": "^0.38.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.9.1",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
